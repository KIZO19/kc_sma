# Copier ce fichier sous .env.local puis renseigner les valeurs depuis le portail Infobip.
PAYMENT_PROVIDER=infobip
PAYMENT_CHANNEL=both

# Utiliser l'URL de base propre au compte Infobip, sans slash final.
PAYMENT_INFOBIP_BASE_URL=https://YOUR-ACCOUNT.api.infobip.com
PAYMENT_INFOBIP_API_KEY=replace-with-a-new-api-key

# WhatsApp doit utiliser un expéditeur/numéro approuvé dans le compte Infobip.
PAYMENT_INFOBIP_WHATSAPP_FROM=replace-with-approved-whatsapp-sender

# Laisser vide pour utiliser le nom de l'école (max. 11 caractères alphanumériques).
# Si besoin, définir ici un expéditeur SMS autorisé par Infobip.
PAYMENT_INFOBIP_SMS_FROM=

# Twilio sert de fournisseur SMS de secours (et de fournisseur principal si PAYMENT_PROVIDER=twilio).
PAYMENT_TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
PAYMENT_TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
PAYMENT_TWILIO_SMS_FROM=replace-with-twilio-sms-number

# Optionnel : expéditeur WhatsApp Twilio approuvé, au format whatsapp:+...
PAYMENT_TWILIO_WHATSAPP_FROM=

# SMTP pour les courriels de réinitialisation du mot de passe.
# Définir l'URL publique complète de l'application, incluant /public.
APP_PUBLIC_URL=http://localhost/kc_sma/public
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=replace-with-smtp-username
MAIL_SMTP_PASSWORD=replace-with-smtp-password
MAIL_SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=KC_SMA

# Notifications push Web (VAPID). Generate keys with:
# C:\xampp\php\php.exe scripts\generate_vapid_keys.php
# Copy the generated values into .env.local; never commit the private key.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
