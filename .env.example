# Copier ce fichier sous .env.local puis renseigner les valeurs depuis le portail Infobip.
PAYMENT_PROVIDER=infobip
PAYMENT_CHANNEL=both

# Utiliser l'URL de base propre au compte Infobip, sans slash final.
PAYMENT_INFOBIP_BASE_URL=https://YOUR-ACCOUNT.api.infobip.com
PAYMENT_INFOBIP_API_KEY=replace-with-a-new-api-key

# WhatsApp doit utiliser un expéditeur/numéro approuvé dans le compte Infobip.
PAYMENT_INFOBIP_WHATSAPP_FROM=replace-with-approved-whatsapp-sender

# SMS utilisera le nom de l'école, normalisé en identifiant alphanumérique (11 caractères max).
# Infobip doit autoriser cet expéditeur alphanumérique dans le compte.
PAYMENT_INFOBIP_SMS_FROM=
